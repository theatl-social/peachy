#!/usr/bin/env bash
# Runs rubocop inside the dev container for consistent Ruby tooling.
# Used by lint-staged to avoid local Ruby/bundler version mismatches.
#
# Usage: bin/docker-rubocop [rubocop args...]
# Example: bin/docker-rubocop --force-exclusion -a app/controllers/foo.rb

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve the dev image, rebuilding it if Gemfile.lock and friends have moved.
# See bin/dev-image: the `docker image inspect` guard that used to live here
# could only detect an absent image, never a stale one.
IMAGE_NAME="$("$SCRIPT_DIR/bin/dev-image")"

# Convert absolute host paths to container-relative paths.
# lint-staged passes absolute paths (e.g. /Users/.../app/controllers/foo.rb)
# but inside the container the project is mounted at /app.
#
# The expansion below is "${args[@]+"${args[@]}"}" rather than "${args[@]}":
# under `set -u`, expanding an empty array is an unbound-variable error, so the
# plain form aborts whenever this script is called with no arguments (linting
# the whole tree). lint-staged always passes paths, which is why that path went
# unnoticed.
args=()
for arg in "$@"; do
  args+=("${arg#"$SCRIPT_DIR/"}")
done

exec docker run --rm \
  -v "$SCRIPT_DIR:/app" \
  -w /app \
  "$IMAGE_NAME" \
  rubocop --config /app/.rubocop.yml "${args[@]+"${args[@]}"}"
