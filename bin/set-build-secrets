#!/usr/bin/env bash
# Push the container-build secrets from a local env file into GitHub Actions.
#
# Usage:
#   bin/set-build-secrets [--file PATH] [--repo OWNER/NAME] [--dry-run] [--yes]
#
# Defaults to .env.build-secrets in the repo root and theatl-social/peachy.
# See .env.build-secrets.example for the file format.
#
# Values are piped to `gh` on stdin rather than passed as arguments, so they
# never appear in the process table. Nothing in this script echoes a value.
#
# Written for bash 3.2, which is what macOS ships — no associative arrays.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SECRETS_FILE="$REPO_ROOT/.env.build-secrets"
TARGET_REPO="theatl-social/peachy"
DRY_RUN=0
ASSUME_YES=0

# Every secret the private build workflows reference. The workflow precheck
# requires all of these, so setting a subset still produces a failing build.
REQUIRED=(
  DOCKER_HUB_USER_NAME
  DOCKER_HUB_ACCESS_TOKEN
  ARG_SECRET_KEY_BASE
  ARG_OTP_SECRET
  ARG_VAPID_PRIVATE_KEY
  ARG_VAPID_PUBLIC_KEY
  ARG_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
  ARG_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
  ARG_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
)

die() { echo "error: $*" >&2; exit 1; }

# Read one KEY's value from the secrets file.
#
# Everything after the first "=" is the value, so base64 padding and embedded
# "=" survive intact. One layer of matching surrounding quotes is stripped. The
# file is parsed, never sourced, so it cannot execute anything. If a key appears
# more than once the last assignment wins, matching dotenv behaviour.
get_value() {
  local key="$1" line value
  line="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$SECRETS_FILE" 2>/dev/null | tail -n 1 || true)"
  [ -n "$line" ] || return 1

  value="${line#*=}"

  # Trim whitespace around the value, so `KEY = v` does not yield " v" and set a
  # secret with a leading space. Trimming happens before quote stripping, so
  # deliberate padding inside quotes — KEY="  v  " — is preserved.
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"

  if [ ${#value} -ge 2 ]; then
    case "$value" in
      \"*\") value="${value:1:${#value}-2}" ;;
      \'*\') value="${value:1:${#value}-2}" ;;
    esac
  fi
  printf '%s' "$value"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --file) SECRETS_FILE="${2:-}"; shift 2 ;;
    --repo) TARGET_REPO="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    -h|--help) sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

command -v gh >/dev/null 2>&1 || die "gh is not installed"
gh auth status >/dev/null 2>&1 || die "gh is not authenticated — run: gh auth login"
[ -f "$SECRETS_FILE" ] || die "no such file: $SECRETS_FILE
Create it with: cp .env.build-secrets.example .env.build-secrets && chmod 600 .env.build-secrets"

# A plaintext secrets file should not be readable by anyone else.
PERMS="$(stat -f '%Lp' "$SECRETS_FILE" 2>/dev/null || stat -c '%a' "$SECRETS_FILE")"
case "$PERMS" in
  600|400) ;;
  *) echo "warning: $SECRETS_FILE is mode $PERMS; tightening to 600" >&2
     chmod 600 "$SECRETS_FILE" ;;
esac

# Refuse to run if the file would be committed. It is covered by .gitignore:90
# (.env.*), but an explicit `git add -f` would defeat that, so check rather than
# assume.
if git -C "$REPO_ROOT" ls-files --error-unmatch "$SECRETS_FILE" >/dev/null 2>&1; then
  die "$SECRETS_FILE is TRACKED BY GIT. Untrack it before continuing:
  git rm --cached '$SECRETS_FILE'"
fi

# Require every secret up front. Setting a subset leaves the build failing, and
# an empty value is worse than a missing one: Dockerfile:380 swallows it and
# precompiles assets against an empty key.
missing=()
for name in "${REQUIRED[@]}"; do
  if ! value="$(get_value "$name")" || [ -z "$value" ]; then
    missing+=("$name")
  fi
done

if [ ${#missing[@]} -gt 0 ]; then
  echo "error: ${#missing[@]} of ${#REQUIRED[@]} required secrets are missing or empty in $SECRETS_FILE:" >&2
  printf '  %s\n' "${missing[@]}" >&2
  exit 1
fi

# Report anything assigned in the file that no workflow uses, so a typo'd name
# is visible rather than silently ignored.
# sed, not `tr -d '[:space:]'` — tr would delete the newlines too and collapse
# every key onto one line.
file_keys="$(grep -oE '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=' "$SECRETS_FILE" \
  | sed -E 's/[[:space:]]//g; s/=$//' | sort -u || true)"
for key in $file_keys; do
  found=0
  for name in "${REQUIRED[@]}"; do
    [ "$key" = "$name" ] && { found=1; break; }
  done
  [ "$found" -eq 0 ] && echo "note: $key is in the file but no workflow uses it — ignoring" >&2
done

echo "Ready to set ${#REQUIRED[@]} secrets on $TARGET_REPO from $SECRETS_FILE"

if [ "$DRY_RUN" -eq 1 ]; then
  echo "(dry run — nothing will be written)"
  printf '  would set %s\n' "${REQUIRED[@]}"
  exit 0
fi

if [ "$ASSUME_YES" -eq 0 ]; then
  printf 'This overwrites any existing values. Continue? [y/N] '
  read -r reply
  case "$reply" in
    [yY]|[yY][eE][sS]) ;;
    *) echo "aborted"; exit 1 ;;
  esac
fi

for name in "${REQUIRED[@]}"; do
  # Value on stdin, never as an argument — keeps it out of the process table.
  get_value "$name" | gh secret set "$name" --repo "$TARGET_REPO"
  echo "  set $name"
done

echo
echo "Done. Verify with:"
echo "  gh secret list --repo $TARGET_REPO"
