# Template for the container-build secrets.
#
#   cp .env.build-secrets.example .env.build-secrets
#   chmod 600 .env.build-secrets
#   # fill in the values, then:
#   bin/set-build-secrets
#
# .env.build-secrets is ignored by .gitignore:90 (.env.*) and must never be
# committed. This template is un-ignored by .gitignore:95 (!.env*.example) and
# holds names only, which are already public in .github/workflows/.
#
# Format is KEY=VALUE, one per line. Values may be quoted; surrounding single or
# double quotes are stripped. Everything after the first "=" is the value, so
# base64 padding and "=" inside a value are safe. Blank lines and #-comments are
# skipped.

# --- Docker Hub registry credentials -----------------------------------------
# The account the image is pushed under; the image is tagged
# $DOCKER_HUB_USER_NAME/mastodon-compiled:<tag>.
DOCKER_HUB_USER_NAME=
# A Docker Hub access token, not the account password.
DOCKER_HUB_ACCESS_TOKEN=

# --- Rails secrets baked in at asset-precompile time --------------------------
# These are mounted as BuildKit secrets and read in Dockerfile:380. A missing one
# does NOT fail the build on its own — it silently yields an empty string — which
# is why bin/set-build-secrets and the workflow precheck both require all nine.
#
# Generate with: bundle exec rails secret
ARG_SECRET_KEY_BASE=
ARG_OTP_SECRET=

# Generate with: bundle exec rails mastodon:webpush:generate_vapid_key
ARG_VAPID_PRIVATE_KEY=
ARG_VAPID_PUBLIC_KEY=

# Generate with: bundle exec rails db:encryption:init
ARG_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ARG_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
ARG_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
